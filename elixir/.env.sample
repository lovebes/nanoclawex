# NanoClaw Elixir — environment variables
# Copy to .env and fill in your values.
#
#   cp .env.sample .env
#
# .env is gitignored. Never commit real credentials.

# ─── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key. Injected into every agent container at runtime.
# Get one at: https://console.anthropic.com → API keys → Create key
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# ─── API endpoint ────────────────────────────────────────────────────────────

# Where containers send Claude API requests.
#
# Phase 1 (no proxy yet): point directly at Anthropic.
# Phase 2 onwards: the in-process credential proxy runs at
#   http://host.docker.internal:4000/api/proxy
# and containers never need a real key — they hit the proxy instead.
#
# host.docker.internal resolves to the host machine from inside a Docker
# container. If you are using Apple Container, it resolves the same way.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Assistant ───────────────────────────────────────────────────────────────

# The trigger word. Messages must contain @<name> to invoke the agent
# (unless requires_trigger is false for a group).
# Change this to whatever name you prefer for your assistant.
ASSISTANT_NAME=Andy

# ─── Container runtime ───────────────────────────────────────────────────────

# The container binary to use. Two options:
#
#   docker     — Docker Desktop or Docker Engine (macOS + Linux, default)
#                Download: https://www.docker.com/products/docker-desktop/
#
#   container  — Apple Container (macOS Apple Silicon only, lighter weight)
#                Install: https://github.com/apple/container/releases
#                Requires macOS 15+ and Apple Silicon.
CONTAINER_RUNTIME=docker

# ─── Timezone ────────────────────────────────────────────────────────────────

# Timezone used when formatting message timestamps inside containers and
# in the XML context passed to the agent.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, America/Los_Angeles, Europe/London, Asia/Tokyo
TZ=America/New_York

# ─── Database (optional override) ────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Defaults to ../store/nanoclaw.db (the Node.js project's database).
# Only set this if your database lives somewhere other than the default.
#
# Example:
# DATABASE_PATH=/Users/yourname/nanoclaw/store/nanoclaw.db
# DATABASE_PATH=
